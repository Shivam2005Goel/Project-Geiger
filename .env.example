# --- Neo4j -----------------------------------------------------------------
# Aura: neo4j+s://<id>.databases.neo4j.io   Local: bolt://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
# NEO4J_POOL_SIZE=25

# --- Required ---------------------------------------------------------------
# Sent to OpenAlex and Crossref so requests land in their "polite pool", which
# has far better rate limits. Both services use it only to contact you about
# crawl behaviour. The pipeline refuses to run without a real address.
GEIGER_CONTACT_EMAIL=

# --- Contamination model ----------------------------------------------------
# Defaults shown. Changing any of these changes published numbers, so bump
# SCORE_VERSION in src/lib/config.ts alongside and re-run `npm run score`.
# GEIGER_HOP_DECAY=0.35
# GEIGER_MAX_GENERATIONS=3
# GEIGER_W_POST_RETRACTION=1.0
# GEIGER_W_PRE_RETRACTION=0.3
# GEIGER_W_UNKNOWN_TIMING=0.5
# GEIGER_REFERENCE_BASELINE=30
# GEIGER_DOSE_SATURATION=1.5
# GEIGER_SEVERITY_RETRACTED=1.0
# GEIGER_SEVERITY_CONCERNED=0.5
# GEIGER_SEVERITY_CORRECTED=0.2
# GEIGER_W_INTENT_DISPUTING=0.15

# --- Limits -----------------------------------------------------------------
# GEIGER_MAX_GRAPH_NODES=600
# GEIGER_MAX_GRAPH_DEPTH=3
# GEIGER_MAX_BIB_ENTRIES=2000
# GEIGER_RATELIMIT_MAX=60
# GEIGER_RATELIMIT_BIB_MAX=6

# --- External APIs ----------------------------------------------------------
# GEIGER_REQUEST_INTERVAL_MS=110
# GEIGER_MAX_RETRIES=4
